{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "./.opencode/plugins/horka-mentor.ts",
      "options": {
        "memoryPath": "~/.config/opencode/mentor",
        "proactive": true,
        "context7": "https://mcp.context7.com/mcp"
