{
  "$schema": "https://opencode.ai/config.json",
  // Single source of truth for plugin loading: auto-discovery via
  // .opencode/plugins/horka-mentor.ts (re-export de src/index.ts).
  // Ne jamais pointer "package" vers ce fichier (doit être un dossier).
  // Exemple d'options actives (à remettre avec "package" vers le dossier si besoin) :
  // { "package": "github:Sokoshy/opencode-horka-mentor", "options": { "memoryPath": "~/.config/opencode/mentor", "proactive": true, "context7": "https://mcp.context7.com/mcp" } }
  "plugins": []
}
